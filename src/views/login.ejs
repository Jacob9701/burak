<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
</head>

<body>

    <form action="/admin/login" method="POST">

        <div>
            <input type="text" name="memberNick" placeholder="memberNick" />
        </div>

        <br />

        <div>
            <input type="password" name="memberPassword" placeholder="memberPassword" />
        </div>

        <br />

        <button type="submit">
            LOGIN
        </button>

    </form>

</body>

</html>